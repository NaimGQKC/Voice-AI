# ============================================================================
#  RESTAURANT VOICE AGENT — copy to `.env` and fill in as you go.
#
#      cp .env.example .env
#      python scripts/check_setup.py       <- tells you exactly what's missing
#      python -m resto_agent.agent console   <- talk to it
#
#  You do NOT need everything at once. Work down the file. TIER 1 gets you
#  talking to the agent on your laptop in ~10 minutes. The rest is for going
#  live, and you can stop after any tier.
#
#  Click-by-click walkthrough, with what each screen looks like: docs/SETUP.md
# ============================================================================


# ============================================================================
#  TIER 1 — talk to it on your laptop.  2 keys.  ~10 min.  No credit card.
# ============================================================================

# 1) DEEPGRAM — speech in AND speech out, both on one key.
#    https://console.deepgram.com/signup   ->  API Keys  ->  Create a New API Key
#    $200 free credit, no card. That's ~45,000 minutes; this venue uses ~111/mo.
DEEPGRAM_API_KEY=

# 2) GOOGLE AI STUDIO — the "brain" (gemini-2.5-flash).
#    https://aistudio.google.com/apikey    ->  Create API key
#    Free tier is fine for laptop testing; see the note in TIER 3 before going live.
GOOGLE_API_KEY=

#  ^ With just those two:   python -m resto_agent.agent console
#    That runs against a FAKE restaurant. No real bookings. Nothing to break.


# ============================================================================
#  TIER 2 — book REAL tables at the venue.  Values you already have.
# ============================================================================

# -- Who the agent says it is -----------------------------------------------
# The venue's identity is NEVER hard-coded in source — the repo ships with
# placeholders so no client's details are committed. Set these per deployment;
# they drive the greeting ("Bonjour. <name>.") and the FAQ answers in faq.py.
# Leave them unset and the agent will happily answer as "{RESTAURANT_NAME}",
# which is a loud, deliberate reminder that it is not configured yet.
AGENT_RESTAURANT_NAME=
AGENT_RESTAURANT_ADDRESS=
AGENT_RESTAURANT_STREET=
AGENT_RESTAURANT_PHONE=
AGENT_RESTAURANT_METRO=
AGENT_RESTAURANT_TZ=America/Toronto


# ⚠️ A long-lived master credential for the real restaurant's reservations.
#    It lives ONLY in this file. Never commit it, never log it, never paste it
#    into a chat window. `.env` is git-ignored — keep it that way.
LIBRO_PRIVATE_TOKEN=
LIBRO_PRIVATE_EMAIL=

# Flip to `libro-private` for REAL bookings. Leave `mock` while you're still
# shaking out voice bugs — you do not want your first voice test to also be
# your first live write.
AGENT_RESERVATION_BACKEND=mock

# French first (this venue is ~2/3 French callers). Omit for English-only.
AGENT_LANGUAGE_MODE=multi


# ============================================================================
#  TIER 3 — a real phone number and a deployment.  See docs/DEPLOY.md.
# ============================================================================

# 3) LIVEKIT CLOUD — carries the audio, bridges the phone call.
#    https://cloud.livekit.io  ->  create project  ->  Settings  ->  API Keys
#    Free "Build" tier is enough: 1,000 SIP minutes/month, we need ~111.
#    NOT needed for `console` mode — only for browser or phone calls.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 4) SUPABASE — the call log, so you can see what the agent actually did.
#    https://supabase.com/dashboard  ->  New project
#    ⚠️ Region MUST be `ca-central-1` (Montréal). This table holds guest names
#       and phone numbers, and Quebec's Law 25 governs that leaving the province.
#    Then: Project Settings -> Database -> Connection string (URI).
#    Leave BLANK to use a local SQLite file (fine for laptop testing).
AGENT_DB_URL=

# 5) TWILIO — the number itself. Do LiveKit FIRST; Twilio points at it.
#    Buy a Montreal 514/438 local number (~$1.15/mo), then create an Elastic
#    SIP Trunk and set its Origination URI to your LiveKit SIP host.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

#    Google's FREE Gemini tier is fine for testing but NOT for a live phone
#    line — it's rate-limited hard enough that one busy evening can exhaust it,
#    and requests then fail rather than slowing down. Add billing before launch.


# ============================================================================
#  OPTIONAL — you almost certainly don't need to touch these.
# ============================================================================

# Which LLM. Default `google` = gemini-2.5-flash: the only model verified to
# have BOTH a sub-700ms first-token time AND a prompt cache whose minimum our
# ~3,690-token prompt actually clears. See docs/MODEL_SHORTLIST.md.
# Swapping is one word here plus that vendor's key:
#   openai | anthropic | groq | qwen | moonshot | zhipu | deepseek | mistral
AGENT_LLM_PROVIDER=google
AGENT_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Voice override. A value containing "/" routes via LiveKit Inference; anything
# else is a Deepgram model name. Empty = Cartesia sonic-3 (French) via LiveKit
# Inference, which needs NO Cartesia account — it bills through LiveKit.
#
# ⚠️ AGENT_TTS_PROVIDER and CARTESIA_API_KEY are DEAD. They were removed when TTS
#    moved to LiveKit Inference; if your .env still has them they do nothing.
AGENT_TTS_MODEL=

# Where the agent alerts the restaurant. Blank = it just writes to the log.
AGENT_ALERT_SMS_TO=
AGENT_ALERT_EMAIL_TO=

# ⚠️ LEAVE AT 0. The SDK default of 3.0 makes the greeting impossible to
#    interrupt AND silently drops the caller's first words. See
#    docs/GREETING_ABANDONMENT.md.
AGENT_AEC_WARMUP_S=0

# Libro endpoint + venue id. Only change if Libro moves.
LIBRO_PRIVATE_BASE_URL=https://api.libroreserve.com
LIBRO_PRIVATE_RESTAURANT_ID=<redacted>

# Local call-log file, used only when AGENT_DB_URL is blank.
AGENT_DB_PATH=resto_calls.db
